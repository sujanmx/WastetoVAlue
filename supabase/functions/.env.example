# ==============================================================================
# Supabase Edge Functions Environment Configuration Template
# NOTE: Place your real secrets in Supabase Dashboard (Project Settings -> Secrets)
# or in local supabase/.env.local (never commit real keys to Git).
# ==============================================================================

# Google Gemini API Configuration (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Supabase Local/Hosted Runtime (Automatically populated by Supabase Edge runtime)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
