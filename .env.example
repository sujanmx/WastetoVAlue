# ==============================================================================
# Waste2Value — Environment Configuration Template
# NOTE: Safe placeholder values only. Never commit real API keys or secrets.
# NEVER put SUPABASE_SERVICE_ROLE_KEY here or in client-side code.
# ==============================================================================

# Application Meta
VITE_APP_NAME=Waste2Value
VITE_APP_TAGLINE="Don't Throw It Away. Find Its Next Value."
VITE_APP_ENV=development

# Supabase Configuration (Required in Production)
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Service Architecture Mode
# Set to 'true' for local design & offline mock testing
# Set to 'false' to require real Supabase authentication and database connectivity
VITE_USE_MOCK_SERVICES=true

# AI Model Services Endpoints (Proxied through backend/Edge Functions; never expose raw provider keys)
VITE_AI_VISION_ENDPOINT=/functions/v1/vision-identify
VITE_AI_VALUE_ENDPOINT=/functions/v1/value-recommend
VITE_AI_MATCHING_ENDPOINT=/functions/v1/match-receivers

# Map & Geolocation
VITE_MAP_PROVIDER=open-street-map
VITE_MAP_DEFAULT_LAT=40.7128
VITE_MAP_DEFAULT_LNG=-74.0060

# Feature Flags
VITE_ENABLE_DEMO_DATA_BADGES=true
VITE_ENABLE_CAMERA_SCAN=true
